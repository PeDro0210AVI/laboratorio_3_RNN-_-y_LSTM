print(f"mejor cambio: {best_r[0]['name']} (delta F1={best_r[1]:+.4f}) diffs={hp_diff(base_r, best_r[0])}")
print(f"peor cambio: {worst_r[0]['name']} (delta F1={worst_r[1]:+.4f}) diffs={hp_diff(base_r, worst_r[0])}")

